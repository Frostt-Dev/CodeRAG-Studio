# Database (PostgreSQL with pgvector running via Docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/coderag
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coderag

# LLM & Embeddings Provider (OpenRouter with NVIDIA Nemotron 3 Ultra 550B)
LLM_PROVIDER=openrouter

# OpenRouter API Key (Get yours from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_EMBEDDING_MODEL=text-embedding-3-small

# Server Configuration
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true
